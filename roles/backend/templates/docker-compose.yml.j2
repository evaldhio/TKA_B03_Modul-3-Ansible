services:
  db:
    image: postgres:15
    environment:
      POSTGRES_DB: {{ db_name }}
      POSTGRES_USER: {{ db_username }}
      POSTGRES_PASSWORD: {{ db_password }}
    ports:
      - "5432:5432"

  backend:
    build: .
    ports:
      - "{{ backend_port }}:{{ backend_port }}"
    env_file: .env
    depends_on:
      - db
